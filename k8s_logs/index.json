{
  "settings": {
    "index.number_of_shards": {{number_of_shards | default(1)}},
    "index.number_of_replicas": {{number_of_replicas | default(0)}},
    "index.refresh_interval": "{{refresh_interval | default('10s')}}",
    "index.search.concurrent_segment_search.mode": {{css_mode | default("auto") | tojson}},
    "index.queries.cache.enabled": {{query_cache_enabled | default(false) | tojson}},
    "index.requests.cache.enable": {{requests_cache_enabled | default(false) | tojson}},
    "index.codec":"{{index_codec | default('best_compression') }}",
    "index.translog.sync_interval": "30s",
    "index.translog.durability": "async"
  },
  "mappings": {
    "properties": {
      "_timestamp":                 { "type": "long" },

      "message":                    { "type": "text" },
      "level":                      { "type": "keyword" },
      "stream":                     { "type": "keyword" },
      "host":                       { "type": "keyword" },

      "kubernetes_namespace_name":  { "type": "keyword" },
      "kubernetes_pod_name":        { "type": "keyword" },
      "kubernetes_container_name":  { "type": "keyword" },
      "kubernetes_node_name":       { "type": "keyword" },
      "kubernetes_labels_app":      { "type": "keyword" },
      "kubernetes_labels_version":  { "type": "keyword" },
      "kubernetes_pod_ip":          { "type": "keyword" },

      "trace_id":                   { "type": "keyword" },
      "span_id":                    { "type": "keyword" },
      "request_id":                 { "type": "keyword" },

      "http_method":                { "type": "keyword" },
      "http_path":                  { "type": "keyword" },
      "http_status":                { "type": "integer" },
      "http_latency_ms":            { "type": "long" },
      "http_bytes_out":             { "type": "long" },

      "client_ip":                  { "type": "keyword" },
      "ja3":                        { "type": "keyword" },
      "user_id":                    { "type": "keyword" },
      "session_id":                 { "type": "keyword" },

      "region":                     { "type": "keyword" },
      "zone":                       { "type": "keyword" },
      "cluster":                    { "type": "keyword" }
    }
  }
}
