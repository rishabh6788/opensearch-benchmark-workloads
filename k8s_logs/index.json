
{% if distribution_version is not defined %}
  {% set distribution_version = "2.11.0" %}
{% endif %}

{% if distribution_version.split('.') | map('int') | list  >= "2.12.0".split('.') | map('int') | list and distribution_version.split('.') | map('int') | list  < "6.0.0".split('.') | map('int') | list %}
  {% set match_only_text = "match_only_text" %}
{% else %}
  {% set match_only_text = "text" %}
{% endif %}

{
  "settings": {
    "index.number_of_shards": {{number_of_shards | default(1)}},
    "index.number_of_replicas": {{number_of_replicas | default(0)}},
    "index.refresh_interval": "{{refresh_interval | default('10s')}}",
    "index.search.concurrent_segment_search.mode": {{css_mode | default("auto") | tojson}},
    "index.queries.cache.enabled": {{query_cache_enabled | default(false) | tojson}},
    "index.requests.cache.enable": {{requests_cache_enabled | default(false) | tojson}},
    {% if distribution_version.split('.') | map('int') | list  >= "2.11.0".split('.') | map('int') | list and distribution_version.split('.') | map('int') | list  < "6.0.0".split('.') | map('int') | list %}
      "index.merge.policy": "{{index_merge_policy | default('log_byte_size') }}",
    {% endif %}
    "index.codec":"{{index_codec | default('best_compression') }}",
    "index.translog.sync_interval": "30s",
    "index.translog.durability": "async",
    "index.query.default_field": [
      "message"
    ]
  },
  "mappings": {
    "date_detection": false,
    "properties": {
      "_timestamp":                 { "type": "long" },

      "message":                    { "type": "{{ match_only_text }}" },
      "level":                      { "type": "keyword", "ignore_above": 1024 },
      "stream":                     { "type": "keyword", "ignore_above": 1024 },
      "host":                       { "type": "keyword", "ignore_above": 1024 },

      "kubernetes_namespace_name":  { "type": "keyword", "ignore_above": 1024 },
      "kubernetes_pod_name":        { "type": "keyword", "ignore_above": 1024 },
      "kubernetes_container_name":  { "type": "keyword", "ignore_above": 1024 },
      "kubernetes_node_name":       { "type": "keyword", "ignore_above": 1024 },
      "kubernetes_labels_app":      { "type": "keyword", "ignore_above": 1024 },
      "kubernetes_labels_version":  { "type": "keyword", "ignore_above": 1024 },
      "kubernetes_pod_ip":          { "type": "keyword", "ignore_above": 1024 },

      "trace_id":                   { "type": "keyword", "ignore_above": 1024 },
      "span_id":                    { "type": "keyword", "ignore_above": 1024 },
      "request_id":                 { "type": "keyword", "ignore_above": 1024 },

      "http_method":                { "type": "keyword", "ignore_above": 1024 },
      "http_path":                  { "type": "keyword", "ignore_above": 1024 },
      "http_status":                { "type": "integer" },
      "http_latency_ms":            { "type": "long" },
      "http_bytes_out":             { "type": "long" },

      "client_ip":                  { "type": "keyword", "ignore_above": 1024 },
      "ja3":                        { "type": "keyword", "ignore_above": 1024 },
      "user_id":                    { "type": "keyword", "ignore_above": 1024 },
      "session_id":                 { "type": "keyword", "ignore_above": 1024 },

      "region":                     { "type": "keyword", "ignore_above": 1024 },
      "zone":                       { "type": "keyword", "ignore_above": 1024 },
      "cluster":                    { "type": "keyword", "ignore_above": 1024 }
    }
  }
}
