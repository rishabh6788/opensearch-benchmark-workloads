{
  "name": "big5",
  "default": true,
  "schedule": [
    {{ benchmark.collect(parts="common/big5-schedule.json") }}
  ]
},
{
  "name": "test",
  "default": false,
  "schedule": [
    {{ benchmark.collect(parts="common/test-schedule.json") }}
  ]
},
{
  "name": "restore-from-snapshot",
  "default": false,
  "schedule": [
    {{ benchmark.collect(parts="common/snapshot-run.json") }}
  ]
},
{
  "name": "ppl",
  "default": false,
  "schedule": [
    {{ benchmark.collect(parts="common/snapshot-ops.json") }},
    {{ benchmark.collect(parts="ppl/ppl-schedule.json") }},
    {{ benchmark.collect(parts="ppl/ppl-schedule-histogram-only.json") }}
  ]
},
{
  "name": "datafusion-ppl",
  "description": "Indexes the whole document corpus using OpenSearch default settings and runs PPL (Piped Processing Language) queries. Requires the SQL plugin to be installed.",
  "default": false,
  "schedule": [
    {% with default_index_settings={}, index_name="big5" %}
    {{ benchmark.collect(parts="../../common_operations/workload_setup.json") }},
    {% endwith %}
    {% if analytics_oversampling | default(false) %}
    {
      "operation": {
        "operation-type": "put-settings",
        "body": {
          "persistent": {
            "analytics.shard_bucket_oversampling_factor": {{ analytics_oversampling_factor | default(1.5) }},
            "cluster.pluggable.dataformat": "composite"
          }
        }
      }
    },
    {% endif %}
    {{ benchmark.collect(parts="ppl/ppl-schedule.json") }},
    {{ benchmark.collect(parts="ppl/ppl-schedule-histogram-only.json") }}
  ]
},
{
  "name": "ppl-calcite-disabled",
  "default": false,
  "schedule": [
    {{ benchmark.collect(parts="common/snapshot-ops.json") }},
    {{ benchmark.collect(parts="ppl/ppl-schedule.json") }}
  ]
},
{
  "name": "intra-segment",
  "description": "Runs search queries for testing intra-segment search",
  "default": false,
  "schedule": [
    {{ benchmark.collect(parts="common/snapshot-ops.json") }},
    {{ benchmark.collect(parts="intra_segment/intra-segment-schedule.json") }}
  ]
},
{
  "name": "page-cache-test",
  "default": false,
  "schedule": [
    {
      "operation": {
        "operation-type": "page-fault-metrics",
        "include-in-reporting": false
      }
    },
    {
      "operation": {
      "operation-type": "clear-page-cache",
      "include-in-reporting": false
      }
    }
  ]
},
{
  "name": "search-with-page-cache",
  "default": false,
  "schedule": [
    {{ benchmark.collect(parts="common/search-with-page-cache-schedule.json") }}
  ]
}
