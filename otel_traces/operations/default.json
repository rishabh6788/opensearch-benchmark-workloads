{
    "name": "delete-span-index",
    "operation-type": "delete-index",
    "only-if-exists": true,
    "index": "{{ index_name | default('otel-v1-apm-span') }}"
},
{
    "name": "create-span-index",
    "operation-type": "create-index",
    "index": "{{ index_name | default('otel-v1-apm-span') }}"
},
{
    "name": "refresh-span-index",
    "operation-type": "refresh",
    "retries": 100,
    "index": "{{ index_name | default('otel-v1-apm-span') }}"
},
{
    "name": "force-merge-span-index",
    "operation-type": "force-merge",
    "request-timeout": {{ force_merge_timeout | default(7200) }},
    "index": "{{ index_name | default('otel-v1-apm-span') }}",
    "mode": "polling",
    "max-num-segments": {{ force_merge_max_num_segments | default(1) }},
    "include-in-results_publishing": true
}
